# TrustGuard Backend — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/trustguard
